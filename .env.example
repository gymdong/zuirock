# Copy to .env and fill in. Never commit real values.

# Public origin of the single deployment. Placeholder: https://zuirock.onrender.com — confirm the real
# subdomain on the Render dashboard (it may get a suffix). Local: http://localhost:3000.
# OAuth redirect URIs to register = ${PUBLIC_ORIGIN}/api/auth/{kakao|naver|google}/callback.
# Also read by apps/mobile/app.config.ts at build time (Android App Links host, extra.publicOrigin).
PUBLIC_ORIGIN=https://zuirock.onrender.com
# Local only; Render injects PORT itself.
PORT=

# PostgreSQL — runtime (pooled, Neon: ?pgbouncer=true&connect_timeout=15) and migrations (direct)
# Neon pooled : postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true&connect_timeout=15
# Neon direct : postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&connect_timeout=15
# local (both): postgresql://zuirock:zuirock@localhost:5432/zuirock
DATABASE_URL=
DIRECT_URL=

# Redis (local: redis://localhost:6379)
REDIS_URL=

# Dev only: 1 enables POST /api/auth/dev-login (never in production; Render must not set it).
DEV_LOGIN=

# Signing keys (random 32+ bytes each)
JWT_SECRET=
STATE_SECRET=
GUEST_TOKEN_SECRET=

# OAuth (login order: Kakao → Naver → Google). Kakao client id = REST API key.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Android release signing (scripts/make-keystore.sh; local machine only, not Render)
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Static hosting / Android App Links (server)
# Comma-separated SHA-256 fingerprints of the Android signing certificate(s) (from scripts/make-keystore.sh)
ANDROID_CERT_SHA256=
# Optional; default com.zuirock.app
ANDROID_PACKAGE=
# Optional; default <cwd>/public (Docker image uses /app/public)
STATIC_ROOT=
