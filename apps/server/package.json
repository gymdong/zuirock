{
  "name": "@zuirock/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:int": "vitest run test/integration",
    "test:prop": "vitest run test/property",
    "test:sim": "vitest run test/socket-sim"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/websockets": "12.1.2",
    "@prisma/client": "6.19.3",
    "@zuirock/game-rules": "workspace:*",
    "@zuirock/shared": "workspace:*",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "^1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/supertest": "^7.2.1",
    "fast-check": "4.10.2",
    "prisma": "6.19.3",
    "supertest": "^7.3.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.3"
  }
}
