{
  "name": "@zuirock/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src mock test",
    "test": "vitest run",
    "web:mock": "EXPO_PUBLIC_API_MOCK=1 expo start --web",
    "export:web:mock": "EXPO_PUBLIC_API_MOCK=1 expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@zuirock/game-rules": "workspace:*",
    "@zuirock/shared": "workspace:*",
    "expo": "57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
