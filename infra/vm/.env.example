# 이 파일을 같은 폴더에 `.env` 로 복사해서 채운다 (cp .env.example .env).
# .env 는 VM 안에서만 둔다. 대화창·GitHub·메신저에 붙여 넣지 않는다(저장소에서도 무시된다).

# --- 필수 ---
# 학교 VM 의 실제 주소(끝에 / 없이). 이미지를 만들 때 쓴 값과 같아야 한다.
PUBLIC_ORIGIN=https://여기에-VM주소.apps.dauai.org

# DB 연결 (Neon 대시보드 > Connect 에서 복사). 비밀번호가 들어 있어서 VM 의 .env 에만 둔다.
#   DATABASE_URL = pooled 주소 (…-pooler… 와 ?sslmode=require&pgbouncer=true&connect_timeout=15)
#   DIRECT_URL   = 직접 연결 주소 (-pooler 없는 것, 마이그레이션용)
DATABASE_URL=
DIRECT_URL=

# 서명용 비밀 값 3개: VM 에서  openssl rand -base64 32  로 각각 만든다.
# (Render 와 같은 DB 를 쓰는 동안 로그인 토큰을 공유하려면 Render 환경 변수와 같은 값을 쓴다 — 값은 대시보드에서 VM 터미널로 직접 옮긴다)
JWT_SECRET=
STATE_SECRET=
GUEST_TOKEN_SECRET=

# --- 카카오 로그인 (Render 환경 변수에 있는 값을 VM 으로 직접 옮긴다) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 선택 ---
# 시연 데이터 초기화 화면(관리자)을 쓰는 동안만 1. 끝나면 지운다.
# DEMO_SEED=1
# 로컬 Postgres 를 쓸 때만 (compose 의 local-db 프로필)
# POSTGRES_PASSWORD=
